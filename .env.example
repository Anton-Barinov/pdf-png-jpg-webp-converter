# Universal Converter Environment Configuration

# Custom application name shown in header and page title
APP_NAME="Universal Converter"

# Storage directory (defaults to private storage outside webroot)
# STORAGE_DIR="/var/www/private/storage/sessions"

# File retention in seconds before permanent wipe (default: 300 = 5 minutes)
TTL_SECONDS=300

# Max upload file size in megabytes
MAX_FILE_SIZE_MB=100

# Max files per upload session
MAX_SESSION_FILES=50

# Default image conversion quality (10-100)
DEFAULT_QUALITY=90
